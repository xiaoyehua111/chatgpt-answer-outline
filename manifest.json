{
  "manifest_version": 3,
  "name": "ChatGPT Answer Outline",
  "version": "0.1.0",
  "description": "ChatGPT 当前回答目录：在 ChatGPT 页面右侧显示当前 AI 回答的标题目录面板。",
  "action": {
    "default_title": "ChatGPT 当前回答目录",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fiber-bridge.js"
      ],
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ]
    }
  ]
}
